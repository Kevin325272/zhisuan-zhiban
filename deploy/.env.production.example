XUETU_HTTP_PORT=80
XUETU_HTTPS_PORT=443
XUETU_PUBLIC_ORIGIN=https://xuetu.lan
XUETU_TLS_SERVER_NAME=xuetu.lan
XUETU_TLS_ISSUER=internal

POSTGRES_DB=xuetu
POSTGRES_USER=xuetu_app
POSTGRES_PASSWORD=replace_with_random_alphanumeric_value
DATABASE_POOL_MAX=10
DATABASE_SSL=disable

NODE_ENV=production
XUETU_AUTH_MODE=session
XUETU_AUTH_COOKIE_SECURE=true
XUETU_TRUST_PROXY=true
XUETU_LISTEN_HOST=0.0.0.0
XUETU_ENABLE_DEV_IDENTITY_HEADER=false
XUETU_ALLOW_MOCK_SCENARIOS=false
XUETU_ENABLE_LEGACY_AGENT_ROUTES=false
XUETU_ENABLE_LEGACY_DEMO_ROUTES=false
XUETU_ALLOW_LOCAL_DEMO_PAST_EXAMS=false

XUETU_STUDENT_REGISTRATION_MODE=self_service
XUETU_DEMO_COURSE_IDS=course_408_ds,course_408_co,course_408_os,course_408_cn
XUETU_INITIAL_ADMIN_PASSWORD=replace_with_temporary_admin_password
XUETU_LEGACY_STUDENT_PASSWORD=replace_with_temporary_demo_password
XUETU_SYNC_DEMO_CREDENTIALS=false

STUDENT_CARE_ENABLED=true
EXTERNAL_QUESTION_STORAGE_DIR=/app/.runtime/external-questions

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=ZHIPU/GLM-5.3-Flash
LLM_TIMEOUT_MS=60000
# Optional: structured workflows use Responses unless a provider requires Chat Completions.
LLM_API_FORMAT=chat_completions
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=4096
AI_WORKFLOW_PROVIDER=openai_compatible
XUETU_ALLOW_UNVERIFIED_AI_SOURCE_EXPORT=true

EVALUATOR_MODE=judge0
EVALUATOR_BASE_URL=https://ce.judge0.com
EVALUATOR_ALLOW_MOCK_FALLBACK=false
EVALUATOR_TIMEOUT_MS=30000
EVALUATOR_MAX_POLL_ATTEMPTS=80
EVALUATOR_MAX_CONCURRENT_RUNS=2
