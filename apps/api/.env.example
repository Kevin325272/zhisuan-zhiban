LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=ZHIPU/GLM-5.3-Flash
LLM_TIMEOUT_MS=60000

# PostgreSQL is the runtime source of truth. The password below is local-development only.
DATABASE_URL=postgresql://xuetu_repro:replace_with_generated_password@127.0.0.1:55435/xuetu_repro
DATABASE_POOL_MAX=10
DATABASE_SSL=disable

# Session authentication is the default. Development identity headers require
# both local_dev and the explicit second switch below; never enable in production.
XUETU_AUTH_MODE=session
XUETU_ENABLE_DEV_IDENTITY_HEADER=false
# Legacy in-memory BFS learner sessions are disabled by default. Enable only
# for explicit local compatibility tests; student AI uses the unified gateway.
XUETU_ENABLE_LEGACY_AGENT_ROUTES=false
# Legacy in-memory BFS course/task state is also opt-in. Keep false for a
# PostgreSQL-backed pilot; set true only when demonstrating the old BFS workbench.
XUETU_ENABLE_LEGACY_DEMO_ROUTES=false
# Production/HTTPS reverse-proxy mode requires an HTTPS browser origin.
XUETU_PUBLIC_ORIGIN=
# Optional explicit API socket address. Docker sets 0.0.0.0 only inside its
# private backend network; ordinary local development should leave this blank.
XUETU_LISTEN_HOST=
# Production defaults to Secure cookies and refuses an explicit false value.
# Set true for an HTTPS reverse-proxy deployment; local HTTP development can leave it false.
XUETU_AUTH_COOKIE_SECURE=false
# Enable only when every API request arrives through the local/private reverse proxy.
# This controls forwarded client addresses; it does not by itself imply HTTPS.
XUETU_TRUST_PROXY=false
# Local-only account seed inputs. Keep these in ignored .env.local; they are
# hashed by `pnpm db:seed:auth` and never returned by the API.
XUETU_INITIAL_ADMIN_PASSWORD=
XUETU_LEGACY_STUDENT_PASSWORD=
# Self-service is the normal 408 learner entry. School-managed deployments may
# explicitly set controlled; both modes bind authorized students to these courses.
XUETU_STUDENT_REGISTRATION_MODE=self_service
XUETU_DEMO_COURSE_IDS=course_408_ds,course_408_co,course_408_os,course_408_cn
# Optional override after running the safe ZIP importer.
QUESTION_BANK_SOURCE_DIR=
# Local-demo past papers remain hidden unless the server operator explicitly
# enables the authenticated demonstration library.
XUETU_ALLOW_LOCAL_DEMO_PAST_EXAMS=false
# Optional override for the verified computer-organization material directory.
COURSE_CONTENT_SOURCE_DIR=
# Optional override for the verified local self-authored exam-paper ZIP.
EXAM_PAPER_ARCHIVE_PATH=

# Optional AI workflow-team service. Both values must be present to enable it.
# provider=xuetu uses the locked /v1/ai-workflows/{capability} contract.
# provider=dify uses one native Dify POST /v1/workflows/run endpoint.
# provider=openai_compatible reuses the server-only LLM_* configuration and
# adapts the configured Chat Completions or Responses output to the same constrained workflow contract
# for plan, explain, coach and diagnose. When selected, legacy workflow URL/key
# values do not override diagnose; switch provider to dify to use that service.
# The OpenAI-compatible workflow adapters use LLM_TIMEOUT_MS; Dify keeps its
# locked 20-second timeout.
# OpenAI-compatible calls use the configured protocol, attach Idempotency-Key, expose only
# provider-reported model/latency audit metadata, and open a 30-second circuit
# after two consecutive retryable upstream failures. Paid generations are not
# retried automatically.
# Protocol compatibility does not imply an OpenAI-hosted or open-source model.
# The secret is server-only and must never use a VITE_ prefix or reach the browser bundle.
AI_WORKFLOW_PROVIDER=openai_compatible
AI_WORKFLOW_BASE_URL=
AI_WORKFLOW_SECRET=
# Local-demo course sources have unverified external-use rights. Keep false
# unless the local operator explicitly permits sending only the selected
# current-concept snippets to the configured server-side AI provider.
XUETU_ALLOW_UNVERIFIED_AI_SOURCE_EXPORT=false

# Optional per-user AI request limiter overrides. Leave unset for the secure
# defaults (30 requests/minute, 2 concurrent requests).
AI_REQUEST_MAX_REQUESTS=
AI_REQUEST_WINDOW_MS=
AI_REQUEST_MAX_CONCURRENT=
AI_REQUEST_MAX_TRACKED_USERS=

# Optional private directory for normalized student question images. Never
# place this under apps/web/public and never commit its contents.
EXTERNAL_QUESTION_STORAGE_DIR=

# Optional Dify profile-interpretation fallback. With
# AI_WORKFLOW_PROVIDER=openai_compatible, profile interpretation also reuses
# LLM_*; keep these unused Dify values empty instead of retaining stale secrets.
AI_PROFILE_WORKFLOW_BASE_URL=
AI_PROFILE_WORKFLOW_SECRET=

# Use "mock" for offline UI work or "judge0" for isolated compilation and execution.
EVALUATOR_MODE=mock
EVALUATOR_BASE_URL=https://ce.judge0.com
EVALUATOR_AUTH_TOKEN=
EVALUATOR_AUTH_HEADER=X-Auth-Token
EVALUATOR_ALLOW_MOCK_FALLBACK=false
EVALUATOR_TIMEOUT_MS=30000
EVALUATOR_POLL_INTERVAL_MS=250
EVALUATOR_MAX_POLL_ATTEMPTS=80
EVALUATOR_MAX_CONCURRENT_RUNS=2
EVALUATOR_CPU_TIME_LIMIT_SECONDS=2
EVALUATOR_WALL_TIME_LIMIT_SECONDS=5
EVALUATOR_MEMORY_LIMIT_KB=131072
EVALUATOR_MAX_PROCESSES=16
EVALUATOR_MAX_FILE_SIZE_KB=1024
# Deterministic student care is opt-in. Keep disabled until migrations and review are complete.
STUDENT_CARE_ENABLED=false
STUDENT_CARE_RULE_VERSION=student_care_v1
STUDENT_CARE_RETURN_MIN_GAP_DAYS=4
STUDENT_CARE_RECENT_MIN_ATTEMPTS=8
STUDENT_CARE_BASELINE_MIN_ATTEMPTS=20
STUDENT_CARE_RECENT_MIN_ERROR_RATE=0.60
STUDENT_CARE_ERROR_RATE_INCREASE=0.25
LLM_API_FORMAT=chat_completions
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=4096
