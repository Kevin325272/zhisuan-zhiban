{
  "name": "xuetu-mvp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @xuetu/api --filter @xuetu/web dev",
    "dev:lan": "pnpm --parallel --filter @xuetu/api --filter @xuetu/web dev:lan",
    "test": "pnpm run data:test && pnpm -r --workspace-concurrency=1 test",
    "data:test": "node --test data/data-structures/tools/*.test.mjs",
    "data:sample": "node data/data-structures/tools/build-bfs-sample.mjs",
    "data:check": "node data/data-structures/tools/check-data.mjs",
    "question-bank:validate": "pnpm --filter @xuetu/api question-bank:validate",
    "course-content:validate": "pnpm --filter @xuetu/api course-content:validate",
    "exam-papers:validate": "pnpm --filter @xuetu/api exam-papers:validate",
    "408-source:validate": "pnpm --filter @xuetu/api 408-source:validate",
    "course-videos:validate": "pnpm --filter @xuetu/api course-videos:validate",
    "db:up": "docker compose -f compose.postgres.yml up -d --wait",
    "db:down": "docker compose -f compose.postgres.yml down",
    "db:setup": "pnpm --filter @xuetu/api db:setup",
    "db:migrate": "pnpm --filter @xuetu/api db:migrate",
    "db:seed:auth": "pnpm --filter @xuetu/api db:seed:auth",
    "db:check": "pnpm --filter @xuetu/api db:check",
    "db:seed:exam-papers": "pnpm --filter @xuetu/api db:seed:exam-papers",
    "db:seed:408-source": "pnpm --filter @xuetu/api db:seed:408-source",
    "db:seed:course-videos": "pnpm --filter @xuetu/api db:seed:course-videos",
    "db:seed:data-structures-curriculum": "pnpm --filter @xuetu/api db:seed:data-structures-curriculum",
    "db:seed:operating-systems-curriculum": "pnpm --filter @xuetu/api db:seed:operating-systems-curriculum",
    "db:seed:computer-networks-curriculum": "pnpm --filter @xuetu/api db:seed:computer-networks-curriculum",
    "db:seed:concept-practice-links": "pnpm --filter @xuetu/api db:seed:concept-practice-links",
    "db:seed:onboarding-diagnostic": "pnpm --filter @xuetu/api db:seed:onboarding-diagnostic",
    "db:seed:admissions": "pnpm --filter @xuetu/api db:seed:admissions",
    "db:seed:pilot-study": "pnpm --filter @xuetu/api db:seed:pilot-study",
    "db:seed:demo-roster": "pnpm --filter @xuetu/api db:seed:demo-roster",
    "db:seed:community": "pnpm --filter @xuetu/api db:seed:community",
    "db:seed:learning-probe": "pnpm --filter @xuetu/api db:seed:learning-probe",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "repro:configure": "node repro/configure.mjs",
    "repro:api": "pnpm --filter @xuetu/api start",
    "repro:web": "node repro/start-web.mjs",
    "repro:model": "node repro/verify-model.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/pg": "8.20.0",
    "pg": "8.22.0",
    "typescript": "^7.0.2"
  }
}
